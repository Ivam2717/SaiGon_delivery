@model IEnumerable<Saigon_delivery.Models.ViewModels.ShipperStatViewModel>
@{
    ViewData["Title"] = "Báo cáo thống kê";
    var groupBy = ViewBag.GroupBy as string ?? "day";
    var chartData = ViewBag.ChartData as List<Saigon_delivery.Models.ViewModels.ChartDataPoint>
                    ?? new List<Saigon_delivery.Models.ViewModels.ChartDataPoint>();
    var labels = System.Text.Json.JsonSerializer.Serialize(chartData.Select(x => x.Label));
    var revenues = System.Text.Json.JsonSerializer.Serialize(chartData.Select(x => x.Revenue));
}

<h1 class="rl-page-title">Báo cáo thống kê</h1>

<div style="display:flex; gap:0.5rem; margin-bottom:1.5rem">
    <a asp-action="Report" asp-route-groupBy="day"
       class="rl-btn @(groupBy == "day" ? "" : "rl-btn-outline") rl-btn-sm">Theo ngày</a>
    <a asp-action="Report" asp-route-groupBy="month"
       class="rl-btn @(groupBy == "month" ? "" : "rl-btn-outline") rl-btn-sm">Theo tháng</a>
</div>

<div class="rl-card" style="margin-bottom:2rem">
    <div class="rl-card-header">
        Doanh thu @(groupBy == "day" ? "theo ngày" : "theo tháng")
    </div>
    <div class="rl-card-body">
        @if (!chartData.Any())
        {
            <div style="text-align:center; color:#aaa; padding:2rem; font-size:13px">
                Chưa có dữ liệu doanh thu
            </div>
        }
        else
        {
            <canvas id="revenueChart" style="max-height:300px"></canvas>
        }
    </div>
</div>

<div class="rl-card">
    <div class="rl-card-header">Thống kê theo shipper</div>
    <div class="rl-card-body" style="padding:0">
        <table class="rl-table">
            <thead>
                <tr>
                    <th>Shipper</th>
                    <th>Tổng đơn</th>
                    <th>Hoàn thành</th>
                    <th>Doanh thu</th>
                    <th>Đánh giá TB</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td style="font-weight:500">@s.ShipperName</td>
                        <td>@s.TotalOrders</td>
                        <td>@s.CompletedOrders</td>
                        <td style="font-weight:500">@s.TotalRevenue.ToString("N0")đ</td>
                        <td>
                            @if (s.AvgRating > 0)
                            {
                                <span style="color:#c8a84b">★</span>
                                @s.AvgRating
                            }
                            else
                            {
                                <span style="color:#aaa">Chưa có</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @if (chartData.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script>
            const ctx = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(labels),
                    datasets: [{
                        label: 'Doanh thu (đ)',
                        data: @Html.Raw(revenues),
                        backgroundColor: 'rgba(26,26,26,0.08)',
                        borderColor: '#1a1a1a',
                        borderWidth: 1,
                        borderRadius: 2,
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: ctx => ctx.parsed.y.toLocaleString('vi-VN') + 'đ'
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: val => val.toLocaleString('vi-VN') + 'đ',
                                font: { size: 11 }
                            },
                            grid: { color: '#f0f0f0' }
                        },
                        x: {
                            ticks: { font: { size: 11 } },
                            grid: { display: false }
                        }
                    }
                }
            });
        </script>
    }
}