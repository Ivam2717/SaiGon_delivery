<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Saigon Delivery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site-custom.css" />
</head>
<body>

    <nav class="rl-nav">
        <div class="rl-nav-top">
            <a class="rl-brand" href="#">Saigon Delivery</a>

            <ul class="rl-nav-links" style="margin-left:auto; margin-right:1.2rem">
                @if (User.IsInRole("Customer"))
                {
                    <li><a asp-controller="Order" asp-action="Create">Đặt hàng</a></li>
                    <li><a asp-controller="Order" asp-action="Index">Đơn của tôi</a></li>
                }
                @if (User.IsInRole("Shipper"))
                {
                    <li><a asp-controller="Shipper" asp-action="Index">Đơn hàng</a></li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li><a asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                    <li><a asp-controller="Admin" asp-action="Orders">Quản lý đơn</a></li>
                    <li><a asp-controller="Admin" asp-action="Report">Báo cáo</a></li>
                }
            </ul>

            <ul class="rl-nav-actions" style="margin-left:0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="rl-user-dropdown">
                        <button class="rl-user-btn" id="userBtn" aria-label="Tài khoản">
                            <i class="bi bi-person-circle" style="font-size:20px"></i>
                        </button>
                        <div class="rl-user-menu" id="userMenu">
                            <div class="rl-user-name">@User.Identity.Name</div>
                            <a href="#">Tài khoản</a>
                            <a asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                        </div>
                    </li>
                }
                <li>
                    <button class="rl-hamburger" id="hamburgerBtn" aria-label="Menu">
                        <i class="bi bi-list" style="font-size:20px"></i>
                    </button>
                </li>
            </ul>
        </div>

        <div class="rl-mobile-menu" id="mobileMenu">
            @if (User.IsInRole("Customer"))
            {
                <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li><a asp-controller="Order" asp-action="Create">Đặt hàng</a></li>
                <li><a asp-controller="Order" asp-action="Index">Đơn của tôi</a></li>
            }
            @if (User.IsInRole("Shipper"))
            {
                <a asp-controller="Shipper" asp-action="Index">Đơn hàng</a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index">Dashboard</a>
                <a asp-controller="Admin" asp-action="Orders">Quản lý đơn</a>
                <a asp-controller="Admin" asp-action="Report">Báo cáo</a>
            }
            <a asp-controller="Account" asp-action="Logout">Đăng xuất</a>
        </div>
    </nav>

    <div class="rl-main">
        @if (TempData["Success"] != null)
        {
            <div class="rl-alert rl-alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="rl-alert rl-alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </div>

    <script>
        const userBtn = document.getElementById('userBtn');
        const userMenu = document.getElementById('userMenu');
        userBtn?.addEventListener('click', function (e) {
            e.stopPropagation();
            userMenu.classList.toggle('open');
        });
        document.addEventListener('click', function () {
            userMenu?.classList.remove('open');
        });

        document.getElementById('hamburgerBtn')?.addEventListener('click', function () {
            document.getElementById('mobileMenu').classList.toggle('open');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>