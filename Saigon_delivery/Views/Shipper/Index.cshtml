@model IEnumerable<Saigon_delivery.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<h1 class="rl-page-title">Đơn hàng được gán</h1>
<p class="rl-page-sub">Danh sách đơn hàng bạn đang phụ trách</p>

@if (!Model.Any())
{
    <div class="rl-empty">
        <p class="rl-empty-title">Chưa có đơn hàng nào</p>
        <p class="rl-empty-sub">Hệ thống sẽ gán đơn cho bạn sớm</p>
    </div>
}
else
{
    <div style="overflow-x:auto">
        <table class="rl-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Lấy hàng tại</th>
                    <th>Giao đến</th>
                    <th>Khoảng cách</th>
                    <th>Phí ship</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var (badgeClass, label) = o.Status switch
                    {
                        "Pending" => ("rl-badge-pending", "Chờ nhận"),
                        "Shipping" => ("rl-badge-shipping", "Đang giao"),
                        "Completed" => ("rl-badge-done", "Hoàn thành"),
                        _ => ("rl-badge-pending", o.Status)
                    };
                    <tr>
                        <td style="color:#aaa">#@o.Id</td>
                        <td>
                            <div>@o.Customer?.FullName</div>
                            <div style="color:#aaa; font-size:11.5px">@o.Customer?.Phone</div>
                        </td>
                        <td style="color:#555; max-width:160px; font-size:12px">@o.PickupAddress</td>
                        <td style="color:#555; max-width:160px; font-size:12px">@o.DeliveryAddress</td>
                        <td>@o.Distance km</td>
                        <td style="font-weight:500">@o.ShipFee.ToString("N0")đ</td>
                        <td><span class="rl-badge @badgeClass">@label</span></td>
                        <td>
                            @if (o.Status == "Pending")
                            {
                                <form asp-action="UpdateStatus" method="post" style="display:inline">
                                    <input type="hidden" name="orderId" value="@o.Id" />
                                    <input type="hidden" name="newStatus" value="Shipping" />
                                    <button type="submit" class="rl-btn rl-btn-sm"
                                            onclick="return confirm('Xác nhận lấy hàng?')">
                                        Lấy hàng
                                    </button>
                                </form>
                            }
                            else if (o.Status == "Shipping")
                            {
                                <form asp-action="UpdateStatus" method="post" style="display:inline">
                                    <input type="hidden" name="orderId" value="@o.Id" />
                                    <input type="hidden" name="newStatus" value="Completed" />
                                    <button type="submit" class="rl-btn rl-btn-sm"
                                            onclick="return confirm('Xác nhận đã giao hàng thành công?')">
                                        Đã giao
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span style="font-size:11px; color:#aaa">Hoàn thành</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}