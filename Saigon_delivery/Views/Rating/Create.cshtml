@model Saigon_delivery.Models.ViewModels.RatingViewModel
@{
    ViewData["Title"] = "Đánh giá shipper";
}

<div style="max-width:480px">
    <a asp-controller="Order" asp-action="Detail" asp-route-id="@Model.OrderId"
       style="font-size:11px; letter-spacing:0.06em; text-transform:uppercase; text-decoration:underline; color:#888">
        ← Quay lại đơn hàng
    </a>

    <h1 class="rl-page-title" style="margin-top:1.2rem">Đánh giá shipper</h1>
    <p class="rl-page-sub">Đơn hàng #@Model.OrderId — Shipper: @Model.ShipperName</p>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="OrderId" />
        <input type="hidden" asp-for="ShipperId" />
        <input type="hidden" asp-for="ShipperName" />

        <div class="rl-field">
            <label class="rl-label">Số sao đánh giá</label>
            <div style="display:flex; gap:0.5rem; margin-top:0.25rem" id="starRow">
                @for (int i = 1; i <= 5; i++)
                {
                    <button type="button" class="star-btn"
                            data-value="@i"
                            style="background:none; border:none; cursor:pointer;
                                       font-size:28px; color:#ccc; padding:0; line-height:1"
                            aria-label="@i sao">
                        ★
                    </button>
                }
            </div>
            <input type="hidden" asp-for="Stars" id="starsInput" />
            <span asp-validation-for="Stars" class="rl-field-error"></span>
        </div>

        <div class="rl-field" style="margin-top:1rem">
            <label asp-for="Comment" class="rl-label">Nhận xét (tuỳ chọn)</label>
            <textarea asp-for="Comment" class="rl-input" rows="4"
                      placeholder="Shipper giao hàng nhanh, thái độ tốt..."
                      style="resize:vertical"></textarea>
            <span asp-validation-for="Comment" class="rl-field-error"></span>
        </div>

        <div style="margin-top:1.5rem">
            <button type="submit" class="rl-btn" style="max-width:200px">
                Gửi đánh giá
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const stars = document.querySelectorAll('.star-btn');
        const input = document.getElementById('starsInput');
        let selected = 0;

        stars.forEach(btn => {
            btn.addEventListener('click', function () {
                selected = parseInt(this.dataset.value);
                input.value = selected;
                highlight(selected);
            });
            btn.addEventListener('mouseenter', function () {
                highlight(parseInt(this.dataset.value));
            });
            btn.addEventListener('mouseleave', function () {
                highlight(selected);
            });
        });

        function highlight(n) {
            stars.forEach((btn, idx) => {
                btn.style.color = idx < n ? '#c8a84b' : '#ccc';
            });
        }
        const initVal = parseInt(input.value);
        if (initVal) { selected = initVal; highlight(initVal); }
    </script>
}