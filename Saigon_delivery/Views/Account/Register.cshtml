@model Saigon_delivery.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký — Saigon Delivery</title>
    <link rel="stylesheet" href="~/css/site-custom.css" />
</head>
<body>
    <nav class="rl-nav">
        <div class="rl-nav-top">
            <a class="rl-brand" href="#">Saigon Delivery</a>
        </div>
    </nav>

    <div class="rl-auth-wrap" style="justify-content:center">
        <div class="rl-auth-form">
            <h1 class="rl-auth-title">Tạo tài khoản</h1>
            <p class="rl-auth-sub">Điền thông tin để bắt đầu</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="rl-field-error" style="margin-bottom:1rem"></div>

                <div class="rl-field">
                    <label asp-for="FullName" class="rl-label">Họ và tên</label>
                    <input asp-for="FullName" class="rl-input" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="FullName" class="rl-field-error"></span>
                </div>

                <div class="rl-field">
                    <label asp-for="Email" class="rl-label">Email</label>
                    <input asp-for="Email" class="rl-input" placeholder="example@email.com" />
                    <span asp-validation-for="Email" class="rl-field-error"></span>
                </div>

                <div class="rl-field">
                    <label asp-for="Phone" class="rl-label">Số điện thoại</label>
                    <input asp-for="Phone" class="rl-input" placeholder="09xxxxxxxx" />
                    <span asp-validation-for="Phone" class="rl-field-error"></span>
                </div>

                <div class="rl-field">
                    <label asp-for="Password" class="rl-label">Mật khẩu</label>
                    <input asp-for="Password" class="rl-input" placeholder="Tối thiểu 6 ký tự" />
                    <span asp-validation-for="Password" class="rl-field-error"></span>
                </div>

                <div class="rl-field">
                    <label asp-for="ConfirmPassword" class="rl-label">Xác nhận mật khẩu</label>
                    <input asp-for="ConfirmPassword" class="rl-input" placeholder="Nhập lại mật khẩu" />
                    <span asp-validation-for="ConfirmPassword" class="rl-field-error"></span>
                </div>

                <div style="margin-top:1.5rem">
                    <button type="submit" class="rl-btn">Tạo tài khoản</button>
                </div>
            </form>

            <hr class="rl-divider" />
            <p style="font-size:12px; color:#666; text-align:center">
                Đã có tài khoản?
                <a asp-action="Login" style="color:#1a1a1a; text-decoration:underline">Đăng nhập</a>
            </p>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>