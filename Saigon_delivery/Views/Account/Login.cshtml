@model Saigon_delivery.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — Saigon Delivery</title>
    <link rel="stylesheet" href="~/css/site-custom.css" />
</head>
<body>
    <nav class="rl-nav">
        <div class="rl-nav-top">
            <a class="rl-brand" href="#">Saigon Delivery</a>
        </div>
    </nav>

    <div class="rl-auth-wrap" style="justify-content:center">
        <div class="rl-auth-form">
            <h1 class="rl-auth-title">Đăng nhập</h1>
            <p class="rl-auth-sub">Chào mừng trở lại</p>

            @if (TempData["Success"] != null)
            {
                <div class="rl-alert rl-alert-success" style="margin-bottom:1rem">@TempData["Success"]</div>
            }

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="rl-field-error" style="margin-bottom:1rem"></div>

                <div class="rl-field">
                    <label asp-for="Email" class="rl-label">Email</label>
                    <input asp-for="Email" class="rl-input" placeholder="example@email.com" />
                    <span asp-validation-for="Email" class="rl-field-error"></span>
                </div>

                <div class="rl-field">
                    <label asp-for="Password" class="rl-label">Mật khẩu</label>
                    <input asp-for="Password" class="rl-input" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="rl-field-error"></span>
                </div>

                <div style="margin-top:1.5rem">
                    <button type="submit" class="rl-btn">Đăng nhập</button>
                </div>
            </form>

            <hr class="rl-divider" />
            <p style="font-size:12px; color:#666; text-align:center">
                Chưa có tài khoản?
                <a asp-action="Register" style="color:#1a1a1a; text-decoration:underline">Đăng ký ngay</a>
            </p>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>